{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stores",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "category",
      "official_url",
      "domains",
      "accepted_brand_ids",
      "base_rewards"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
      },
      "category": {
        "enum": [
          "convenience",
          "drugstore",
          "supermarket",
          "restaurant",
          "cafe",
          "other"
        ]
      },
      "official_url": {
        "type": "string",
        "pattern": "^https://"
      },
      "domains": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "accepted_brand_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "uniqueItems": true
      },
      "accepted_source": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "official_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "evidence_quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "last_verified": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "verified": {
            "type": "boolean",
            "description": "根拠文が公式ページに実在することを機械で確認済みか"
          },
          "verified_brand_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "支払い方法ページで機械確認できたブランド"
          }
        },
        "required": [
          "official_url",
          "evidence_quote",
          "last_verified"
        ]
      },
      "base_rewards": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "brand_id",
            "how",
            "rate_value",
            "rate_text",
            "official_url",
            "evidence_quote",
            "last_verified"
          ],
          "properties": {
            "brand_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            },
            "how": {
              "enum": [
                "提示",
                "支払い",
                "提示+支払い"
              ]
            },
            "rate_value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "rate_text": {
              "type": "string",
              "maxLength": 30
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 40
            },
            "official_url": {
              "type": "string",
              "pattern": "^https://"
            },
            "evidence_quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "last_verified": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "verified": {
              "type": "boolean",
              "description": "根拠文が公式ページに実在することを機械で確認済みか"
            }
          }
        }
      }
    }
  }
}