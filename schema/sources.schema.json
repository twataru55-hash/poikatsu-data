{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sources",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "url",
      "brand_ids",
      "kind",
      "render",
      "frequency",
      "domains"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      },
      "name": {
        "type": "string"
      },
      "url": {
        "type": "string",
        "pattern": "^https://"
      },
      "brand_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        }
      },
      "store_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        }
      },
      "kind": {
        "enum": [
          "official",
          "secondary"
        ]
      },
      "render": {
        "enum": [
          "static",
          "js"
        ]
      },
      "frequency": {
        "enum": [
          "daily",
          "weekly"
        ]
      },
      "domains": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "enabled": {
        "type": "boolean"
      },
      "note": {
        "type": [
          "string",
          "null"
        ]
      },
      "follow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern"
        ],
        "description": "公式の詳細URLを列挙し、処理済みを含め取得上限内で古い確認順に再取得。未巡回も記録する",
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "max_new": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "render": {
            "enum": [
              "static",
              "js"
            ]
          },
          "seeds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https://"
            }
          },
          "pagination_pattern": {
            "type": "string"
          },
          "max_list_pages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "redirect_hosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "redirect_label_pattern": {
            "type": "string"
          }
        }
      },
      "content_selector": {
        "type": "string"
      },
      "exclude_selectors": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
